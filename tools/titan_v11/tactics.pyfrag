    # Independent movement additions. The carrier's pass/shot choice and all
    # physics/keeper/cover/counterpress routines remain the original v10.
    PASSING_LANE_ARCHITECT = False
    COUNTERATTACK_FIREWALL = False

    def _v11_lane(self, obs, p, receiver, friends, opponents, baseline):
        bx, by = obs.ball.position
        vx, vy = obs.ball.velocity
        # Bounded, local alternatives: retain shape and create two new angles.
        # The physics verifier predicts defenders and the receiver's momentum.
        candidates = [baseline,
            self._target(receiver[1]+3.0, receiver[2]-5.0),
            self._target(receiver[1]+3.0, receiver[2]+5.0)]
        best = None
        saved = self._next_receive_aim
        try:
            for tx, ty in candidates:
                if not 5.0 < math.hypot(tx-bx, ty-by) < 35.0:
                    continue
                for speed in (14.0, 20.0):
                    option = self._link_option(p,bx,by,vx,vy,receiver,opponents,tx,ty,speed)
                    if option is None:
                        continue
                    aim = self._next_receive_aim or option[3][1:]
                    move = self._move(receiver, self._target(*aim), friends)
                    launch = self._carrier_contact(p,bx,by,
                        *self._requested_velocity(vx,vy,option[1]),option[2])
                    if launch is None:
                        continue
                    path = self._pass_path(launch,(bx,by),1.8)
                    race = self._pass_race(receiver,path,opponents,self.LINK_MARGIN,
                        self._dt,1.8,first_move=move)
                    if race is None:
                        continue
                    (arrival, point), enemy = race
                    # Preserve spacing from every other teammate along the
                    # flight, including the carrier after its initial contact.
                    blocked = False
                    for t, x, y in path:
                        if t >= arrival-.10:
                            break
                        for q in friends:
                            if q[0] == receiver[0] or (q[0] == p[0] and t < .30):
                                continue
                            if self._eta(q,x,y) <= t-.05:
                                blocked = True
                                break
                        if blocked:
                            break
                    if blocked:
                        continue
                    # Wider angles are useful when a defender is moving into
                    # the old lane. Score predicted separation at reception.
                    space = min((math.hypot(point[0]-q[1]-q[3]*min(arrival,.6),
                                           point[1]-q[2]-q[4]*min(arrival,.6))
                                 for q in opponents),default=20.0)
                    travel = math.hypot(aim[0]-receiver[1],aim[1]-receiver[2])
                    score = option[0]+min(space,12.0)*.12-travel*.04
                    if best is None or score > best[0]:
                        best = score, self._target(*aim)
            return best
        finally:
            # Support planning must not leak its speculative receiver aim
            # into the real carrier's established pass selection.
            self._next_receive_aim = saved

    def _v11_firewall(self, obs, guard, opponents, baseline):
        bx, by = obs.ball.position
        if bx < 0.0 or not opponents:
            return None
        threats = []
        for q in opponents:
            if q[0] == 5 or q[1] > bx-4.0:
                continue
            # Short public-velocity projection: do not invent a future pass.
            tx, ty = self._target(q[1]+q[3]*.6, q[2]+q[4]*.6)
            gap = math.hypot(tx-bx,ty-by)
            if not 6.0 < gap < 42.0:
                continue
            flight = self._flight(gap,20.0)
            goal_distance = math.hypot(tx-self._left,ty)
            danger = flight+goal_distance/self._speed
            # The fastest reachable outlet-to-goal corridor is screened.
            x = max(baseline[0]-12.0,min(baseline[0],bx-10.0,tx-4.0))
            fraction = _clip((x-self._left)/max(3.0,tx-self._left),0.0,1.0)
            target = self._target(x,ty*fraction)
            if (self._eta(guard,*target) > 1.6 or
                    math.hypot(target[0]-baseline[0],target[1]-baseline[1]) > 18.0):
                continue
            threats.append((danger,target))
        return min(threats,key=lambda item:item[0])[1] if threats else None

    def _v11_targets(self, obs, friends, opponents, chaser, targets,
                     protected, receive_target, actions):
        own_ids = {p[0] for p in friends}
        # A newly opposing physical touch overrides stale control metadata.
        own = (obs.ball.controlling_team == 0 and
               obs.ball.controlling_player in own_ids and
               obs.ball.last_touch not in {p[0] for p in opponents})
        events = []
        self._v11_proposals = {}
        if getattr(self,'_v11_was_own',False) and not own and self.COUNTERATTACK_FIREWALL:
            events.append('firewall_loss_release')
        self._v11_was_own = own
        if protected or not own:
            # No sticky attack instruction can delay v10 interception,
            # counterpress, goalkeeper or defensive cover after possession loss.
            if events:
                actions.debug['titan_v11'] = tuple(events)
            return
        carrier_ids = {p[0] for p in friends if obs.can_kick(p[0])}
        protected_ids = {0, chaser[0], self._shape_cover_id,
                         self._cover_id, *carrier_ids}
        if receive_target is not None:
            protected_ids.add(receive_target[0])
        if self._receive_plan is not None:
            protected_ids.add(self._receive_plan[0])
        # Preserve the original transition burst and counterpress priority.
        if self.PASSING_LANE_ARCHITECT and not self._transition_active and obs.tick >= self._press_until:
            carrier = next((p for p in friends if p[0] in carrier_ids),None)
            if carrier is not None:
                eligible = [q for q in friends[1:] if q[0] not in protected_ids
                            and 5.0 < math.hypot(q[1]-obs.ball.position[0],
                                                q[2]-obs.ball.position[1]) < 35.0]
                for q in eligible[:2]:
                    option = self._v11_lane(obs,carrier,q,friends,opponents,targets[q[0]])
                    if (option is not None and math.dist(option[1],targets[q[0]]) > 1.0
                            and math.dist(self._move(q,option[1],friends),
                                          self._move(q,targets[q[0]],friends)) > .05):
                        targets[q[0]] = option[1]
                        self._v11_proposals[q[0]] = ('architect_support', self._move(q,option[1],friends))
        if self.COUNTERATTACK_FIREWALL and self._shape_cover_id is not None:
            guard = next((p for p in friends[1:] if p[0] == self._shape_cover_id),None)
            excluded = {0,chaser[0],*carrier_ids}
            if self._receive_plan is not None:
                excluded.add(self._receive_plan[0])
            if guard is not None and guard[0] not in excluded:
                target = self._v11_firewall(obs,guard,opponents,targets[guard[0]])
                if (target is not None and math.dist(target,targets[guard[0]]) > 1.0
                        and math.dist(self._move(guard,target,friends),
                                      self._move(guard,targets[guard[0]],friends)) > .05):
                    targets[guard[0]] = target
                    self._v11_proposals[guard[0]] = ('firewall_screen', self._move(guard,target,friends))
        if events:
            actions.debug['titan_v11'] = tuple(events)

    def _v11_executions(self, actions):
        events = list(actions.debug.get('titan_v11', ()))
        executed = []
        for pid, (name, movement) in getattr(self,'_v11_proposals',{}).items():
            actual = actions.players.get(pid)
            if (actual is not None and actual.kick_direction is None
                    and math.dist(actual.movement,movement) < 1e-8):
                events.append(name)
                executed.append((name,pid))
        if events:
            actions.debug['titan_v11'] = tuple(events)
        if executed:
            actions.debug['titan_v11_players'] = tuple(executed)
