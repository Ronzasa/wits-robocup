    ADAPTIVE_ARCHITECT = True

    def _adaptive_lane(self, obs, p, receiver, friends, opponents, baseline):
        bx, by = obs.ball.position
        vx, vy = obs.ball.velocity
        # Bounded, local alternatives: retain shape and create two new angles.
        # The physics verifier predicts defenders and the receiver's momentum.
        candidates = [baseline,
            self._target(receiver[1]+3.0, receiver[2]-5.0),
            self._target(receiver[1]+3.0, receiver[2]+5.0)]
        best = None
        base_score = None
        saved = self._next_receive_aim
        try:
            for index, (tx, ty) in enumerate(candidates):
                if not 5.0 < math.hypot(tx-bx, ty-by) < 35.0:
                    continue
                for speed in (14.0, 20.0):
                    option = self._link_option(p,bx,by,vx,vy,receiver,opponents,tx,ty,speed)
                    if option is None:
                        continue
                    aim = self._next_receive_aim or option[3][1:]
                    move = self._move(receiver, baseline if index == 0 else self._target(*aim), friends)
                    launch = self._carrier_contact(p,bx,by,
                        *self._requested_velocity(vx,vy,option[1]),option[2])
                    if launch is None:
                        continue
                    path = self._pass_path(launch,(bx,by),1.8)
                    race = self._pass_race(receiver,path,opponents,self.LINK_MARGIN,
                        self._dt,1.8,first_move=move)
                    if race is None:
                        continue
                    (arrival, point), enemy = race
                    # Preserve spacing from every other teammate along the
                    # flight, including the carrier after its initial contact.
                    blocked = False
                    for t, x, y in path:
                        if t >= arrival-.10:
                            break
                        for q in friends:
                            if q[0] == receiver[0] or (q[0] == p[0] and t < .30):
                                continue
                            if self._eta(q,x,y) <= t-.05:
                                blocked = True
                                break
                        if blocked:
                            break
                    if blocked:
                        continue
                    # Wider angles are useful when a defender is moving into
                    # the old lane. Score predicted separation at reception.
                    space = min((math.hypot(point[0]-q[1]-q[3]*min(arrival,.6),
                                           point[1]-q[2]-q[4]*min(arrival,.6))
                                 for q in opponents),default=20.0)
                    travel = math.hypot(aim[0]-receiver[1],aim[1]-receiver[2])
                    progress = math.hypot(self._right-bx,by)-math.hypot(self._right-point[0],point[1])
                    score = (.9+progress*.15+min(enemy-arrival,.8)*3.0-arrival*.7
                             +min(space,9.0)*.10+min(space,12.0)*.12-travel*.04)
                    if abs(point[1]) < 12.0 and point[0] > self._right-27.0:
                        score += 1.0
                    if index == 0:
                        base_score = score if base_score is None else max(base_score,score)
                        continue
                    if best is None or score > best[0]:
                        best = score, self._target(*aim)
            if best is None:
                return None, 'adaptive_reject_no_verified_lane'
            if base_score is not None and best[0] <= base_score+.35:
                return None, 'adaptive_reject_no_gain'
            return (best[0],best[1],None if base_score is None else best[0]-base_score), 'adaptive_verified_gain'
        finally:
            # Support planning must not leak its speculative receiver aim
            # into the real carrier's established pass selection.
            self._next_receive_aim = saved

    def _adaptive_pressure(self, obs, friends, opponents, eligible, targets):
        bx,by=obs.ball.position
        vx,vy=obs.ball.velocity
        near=[]
        closing=[]
        stationary_block=[]
        for q in opponents:
            if q[0] == len(friends):
                continue
            dx,dy=bx-q[1],by-q[2]
            gap=math.hypot(dx,dy)
            approach=(dx*q[3]+dy*q[4])/max(gap,.01)
            if gap < 11.0:near.append(q)
            if gap < 14.0 and approach > 1.2:closing.append(q)
            if 4.0 < q[1]-bx < 23.0 and abs(q[2]-by) < 17.0 and approach < 1.2:
                stationary_block.append(q)
        samples=self._trajectory(bx,by,vx,vy)
        enemy=min((self._intercept(q,samples)[0] for q in near),default=100.)
        lanes=[self._lane(bx,by,*targets[q[0]],20.,opponents) for q in eligible]
        blocked=sum(room <= 1.5 for room in lanes)
        data={'nearby_defenders':len(near),'closing_defenders':len(closing),
              'enemy_race_seconds':min(enemy,100.),'blocked_shape_lanes':blocked,
              'available_shape_lanes':len(lanes)-blocked}
        if len(stationary_block)>=3:
            return False,'adaptive_reject_compact',data
        if not (len(near)>=2 and len(closing)>=2 and enemy<=.8 and blocked>=1):
            return False,'adaptive_reject_low_pressure',data
        return True,'adaptive_pressure',data

    def _v11_targets(self, obs, friends, opponents, chaser, targets,
                     protected, receive_target, actions):
        self._v11_proposals={}
        self._adaptive_obs=obs
        if (obs.tick <= getattr(self,'_adaptive_tick',-1) or
                tuple(obs.score) != getattr(self,'_adaptive_score',tuple(obs.score))):
            self._adaptive_recent={}
        self._adaptive_tick=obs.tick
        self._adaptive_score=tuple(obs.score)
        if not hasattr(self,'_adaptive_recent'):
            self._adaptive_recent={}
        own=(obs.ball.controlling_team==0 and
             obs.ball.controlling_player in {q[0] for q in friends} and
             obs.ball.last_touch not in {q[0] for q in opponents})
        if not own:
            if obs.ball.last_touch in {q[0] for q in opponents}:
                self._adaptive_recent={}
            return
        if (protected or self._transition_active or obs.tick < self._press_until
                or not self.ADAPTIVE_ARCHITECT):
            return
        carriers={q[0] for q in friends if obs.can_kick(q[0])}
        carrier=next((q for q in friends if q[0] in carriers),None)
        if carrier is None or carrier[0]==0:
            return
        excluded={0,chaser[0],self._shape_cover_id,self._cover_id,*carriers}
        if receive_target is not None:excluded.add(receive_target[0])
        if self._receive_plan is not None:excluded.add(self._receive_plan[0])
        eligible=[q for q in friends[1:] if q[0] not in excluded and
                  5.0 < math.dist(q[1:3],obs.ball.position) < 35.0][:2]
        if not eligible:
            actions.debug['titan_v11']=('adaptive_reject_no_free_support',)
            return
        pressure,reason,data=self._adaptive_pressure(obs,friends,opponents,eligible,targets)
        events=[reason]
        actions.debug['adaptive_pressure']=data
        if pressure:
            for q in eligible:
                option,decision=self._adaptive_lane(obs,carrier,q,friends,opponents,targets[q[0]])
                if option is None:
                    events.append(decision)
                    continue
                move=self._move(q,option[1],friends)
                if (math.dist(option[1],targets[q[0]])<=1.0 or
                        math.dist(move,self._move(q,targets[q[0]],friends))<=.05):
                    events.append('adaptive_reject_no_movement_gain')
                    continue
                targets[q[0]]=option[1]
                self._v11_proposals[q[0]]=('adaptive_support',move)
                events.append('adaptive_verified_gain')
        actions.debug['titan_v11']=tuple(events[:6])

    def _v11_executions(self, actions):
        self._original_architect_executions(actions)
        obs=self._adaptive_obs
        for name,pid in actions.debug.get('titan_v11_players',()):
            if name=='adaptive_support':self._adaptive_recent[pid]=obs.tick
        plan=self._receive_plan
        if plan is not None:
            rid,pid,expiry=plan
            action=actions.players.get(pid)
            if action is not None and action.kick_direction is not None:
                supported=obs.tick-self._adaptive_recent.get(rid,-10000)<=int(2.*self._hz)
                actions.debug['adaptive_pass_plan']={'receiver':rid,'passer':pid,
                    'recent_supported_receiver':supported}
